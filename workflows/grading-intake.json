      "id": "b14cd44c-d132-4f4d-91dc-369aa734680a",
      "name": "Build Prompt",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        1648,
        224
      ]
    },
    {
      "parameters": {
