    {
      "parameters": {
        "sendTo": "={{ $('Settings').item.json.instructor_email }}",
        "subject": "={{ \"Gleams: AI draft ready - \" + $('Check AI Grade').item.json.activity_title }}",
        "message": "={{ (() => { const d = $('Check AI Grade').item.json; const s = $('Settings').item.json; const esc = v => String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); const rows = JSON.parse(d.criteria_json).map(r => '<tr><td>' + esc(r.title) + '</td><td>' + r.points + ' / ' + r.max + '</td><td>' + esc(r.justification) + '</td></tr>').join(''); const base = s.decision_base_url + '/gleams-decision?token=' + d.token; return '<p>An AI <b>draft</b> grade is ready for you to check.</p><p><b>Activity:</b> ' + esc(d.activity_title) + '<br><b>Course:</b> ' + esc(d.course_title) + '<br><b>Student ref:</b> ' + esc(d.student_ref) + '<br><b>Days late:</b> ' + d.days_late + '</p><table border=\"1\" cellpadding=\"6\" cellspacing=\"0\"><tr><th>Criterion</th><th>Points</th><th>Reason</th></tr>' + rows + '</table><p><b>Draft total: ' + d.total + ' / ' + d.max_total + '</b></p><p><b>Feedback draft:</b> ' + esc(d.feedback || '(none)') + '</p><p><a href=\"' + base + '&decision=approve\">Approve</a> &nbsp;|&nbsp; <a href=\"' + base + '&decision=reject\">Reject</a></p><p>This is only a draft. Late deductions are not included. Nothing goes to the class record until you approve.</p>'; })() }}",
        "options": {
          "appendAttribution": false
        }
      },
