    {
      "id": "24fd33ee-7dcc-42b2-a9bb-6711e8fcdf1d",
      "name": "Build Confirm Page",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        160
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const q = $('Decision Link Webhook').item.json.query || {};\nconst token = String(q.token || '');\nconst decision = String(q.decision || '').toLowerCase();\nconst row = $json || {};\nconst esc = (v) => String(v === undefined || v === null ? '' : v).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nconst page = (title, body, code) => ({\n  json: {\n    http_code: code,\n    html: '<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>' + esc(title) + '</title><style>body{font-family:Arial,sans-serif;max-width:640px;margin:40px auto;padding:0 16px;color:#222}table{border-collapse:collapse;width:100%}td,th{border:1px solid #ccc;padding:6px;text-align:left}button{padding:10px 20px;font-size:16px;cursor:pointer}</style></head><body><h2>' + esc(title) + '</h2>' + body + '</body></html>'\n  }\n});\nif (!row.submission_id) {\n  return page('Link not valid', '<p>This link is not valid or has expired.</p>', 404);\n}\nif (decision !== 'approve' && decision !== 'reject') {\n  return page('Link not valid', '<p>This link does not have a valid decision.</p>', 400);\n}\nif (row.status !== 'draft') {\n  return page('Already handled', '<p>This hand-in is already <b>' + esc(row.status) + '</b>. Nothing was changed.</p>', 200);\n}\nlet rows = [];\ntry { rows = JSON.parse(row.criteria_json || '[]'); } catch (e) { rows = []; }\nconst trs = rows.map((r) => '<tr><td>' + esc(r.title) + '</td><td>' + esc(r.points) + ' / ' + esc(r.max) + '</td><td>' + esc(r.justification) + '</td></tr>').join('');\nconst verb = decision === 'approve' ? 'Approve' : 'Reject';\nconst body = '<p>Please check this draft before you ' + verb.toLowerCase() + ' it.</p>'\n  + '<p><b>Activity:</b> ' + esc(row.activity_title) + '<br><b>Course:</b> ' + esc(row.course_title) + '<br><b>Student ref:</b> ' + esc(row.student_ref) + '<br><b>Days late:</b> ' + esc(row.days_late) + '</p>'\n  + '<table><tr><th>Criterion</th><th>Points</th><th>Reason</th></tr>' + trs + '</table>'\n  + '<p><b>Draft total: ' + esc(row.total) + ' / ' + esc(row.max_total) + '</b></p>'\n  + '<p><b>Feedback draft:</b> ' + esc(row.feedback || '(none)') + '</p>'\n  + '<form method=\"POST\" action=\"/webhook/gleams-decide\"><input type=\"hidden\" name=\"token\" value=\"' + esc(token) + '\"><input type=\"hidden\" name=\"decision\" value=\"' + esc(decision) + '\"><button type=\"submit\">Confirm: ' + verb + '</button></form>'\n  + '<p><small>Nothing is saved to the class record until you press the button.</small></p>';\nreturn page(verb + ' this draft?', body, 200);"
      }
    },
