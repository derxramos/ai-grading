    {
      "id": "2172793e-9177-4030-b554-e43584f1fc90",
      "name": "Evaluate Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1080,
        560
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const PENALTY_PERCENT_PER_DAY = 10;\nconst req = $('Read Decision').item.json;\nconst row = $json || {};\nconst esc = (v) => String(v === undefined || v === null ? '' : v).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nconst page = (title, body) => '<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>' + esc(title) + '</title><style>body{font-family:Arial,sans-serif;max-width:640px;margin:40px auto;padding:0 16px;color:#222}</style></head><body><h2>' + esc(title) + '</h2>' + body + '</body></html>';\nconst info = (title, text, code) => ({ json: { outcome: 'info', http_code: code, html: page(title, '<p>' + esc(text) + '</p>') } });\nif (!row.submission_id) return info('Link not valid', 'This link is not valid or has expired.', 404);\nif (req.decision !== 'approve' && req.decision !== 'reject') return info('Link not valid', 'The decision must be approve or reject.', 400);\nif (row.status !== 'draft') return info('Already handled', 'This hand-in is already ' + row.status + '. Nothing was changed.', 200);\nconst round2 = (n) => Math.round(n * 100) / 100;\nconst maxTotal = Number(row.max_total) || 0;\nconst aiTotal = Number(row.total) || 0;\nconst daysLate = Math.max(0, Number(row.days_late) || 0);\nconst penalty = round2(Math.min(maxTotal, maxTotal * PENALTY_PERCENT_PER_DAY / 100 * daysLate));\nconst finalScore = round2(Math.max(0, aiTotal - penalty));\nconst decidedAt = new Date().toISOString();\nconst base = {\n  submission_id: row.submission_id,\n  student_ref: row.student_ref,\n  course_title: row.course_title,\n  activity_title: row.activity_title,\n  token: row.token,\n  max_total: maxTotal,\n  ai_total: aiTotal,\n  days_late: daysLate,\n  late_penalty: penalty,\n  final_score: finalScore,\n  criteria_json: row.criteria_json,\n  feedback: row.feedback,\n  decided_at: decidedAt\n};\nif (req.decision === 'approve') {\n  const body = '<p>The grade is saved to the class record.</p><p><b>Student ref:</b> ' + esc(row.student_ref) + '<br><b>AI draft total:</b> ' + aiTotal + ' / ' + maxTotal + '<br><b>Late penalty (' + daysLate + ' day(s) x ' + PENALTY_PERCENT_PER_DAY + '%):</b> -' + penalty + '<br><b>Final score: ' + finalScore + ' / ' + maxTotal + '</b></p>';\n  return { json: Object.assign({ outcome: 'approve', http_code: 200, html: page('Approved', body) }, base) };\n}\nreturn { json: Object.assign({ outcome: 'reject', http_code: 200, html: page('Rejected', '<p>The draft was rejected. Nothing was saved to the class record. Please grade this hand-in yourself.</p>') }, base) };"
      }
    },
    {
      "id": "5a20e9e1-3c8d-4a48-b33d-626b437a0885",
      "name": "Route Outcome",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        1360,
        560
      ],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "outputKey": "approve",
              "renameOutput": true,
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.outcome }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "approve"
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "outputKey": "reject",
              "renameOutput": true,
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.outcome }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "reject"
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "info"
        }
      }
    },
