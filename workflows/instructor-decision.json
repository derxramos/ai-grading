    {
      "id": "c0868a95-b081-4f1a-9766-dcc19410ad08",
      "name": "Find Draft For Page",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        520,
        160
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "l5HxNWfmWnhuRtN1"
        },
        "matchType": "allConditions",
        "filters": {
