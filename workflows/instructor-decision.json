    {
      "id": "c83b8f74-4712-4f16-b873-d719e666cb60",
      "name": "Find Draft",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        800,
        560
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "l5HxNWfmWnhuRtN1"
        },
        "matchType": "allConditions",
        "filters": {
